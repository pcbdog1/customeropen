  "growth_policy": {
    "zero_result_trigger_count": 3,
    "on_trigger": [
      "rotate to unused products within the same industry",
      "combine one product alias with one unused job title",
      "combine one product alias with one unused procurement term",
      "move to an adjacent industry category if the current category remains empty",
      "record useful new hardware product phrases found on attributable public company pages"
    ],
    "automatic_add_rules": {
      "source_url_required": true,
      "hardware_relevance_required": true,
      "minimum_phrase_words": 1,
      "maximum_phrase_words": 6,
      "normalize_case": true,
      "trim_whitespace": true,
      "deduplicate_case_insensitive": true,
      "reject_email_addresses": true,
      "reject_person_names": true,
      "reject_software_only_terms": true,
      "reject_peer_manufacturer_terms": true
    },
