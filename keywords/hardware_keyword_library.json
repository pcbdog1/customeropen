  "metadata": {
    "name": "PCBDOG Global Hardware Prospect Keyword Library",
    "version": "1.0.0",
    "language": "English",
    "created_at": "2026-08-04",
    "purpose": "Discover global end customers that design or sell electronic hardware and may outsource PCB fabrication, PCBA assembly, component sourcing, programming, testing, prototypes, or small-batch production.",
    "exclusions": [
      "Russia",
      "pure software companies",
      "PCB manufacturers",
      "PCBA manufacturers",
      "EMS competitors",
      "unattributed or leaked contact data"
    ]
  },
  "combination_policy": {
    "required_dimensions": [
      "country",
      "industry",
      "product",
      "job_title",
      "procurement_term"
    ],
    "max_products_per_industry_query_batch": 4,
    "max_job_titles_per_query_batch": 3,
    "max_procurement_terms_per_query_batch": 3,
    "prefer_long_tail_queries": true,
    "templates": [
      "{country} {industry} {product} manufacturer {job_title}",
      "{country} {industry} {product} company {procurement_term}",
      "site:linkedin.com/company {country} {product} electronics",
      "{country} {product} embedded hardware contact",
      "{country} {product} electronics manufacturer info sales",
      "{country} {product} {job_title} jobs",
      "{country} {product} {procurement_term} supplier",
      "{country} {industry} OEM {product} engineering",
      "{country} {product} prototype electronics company",
      "{country} {product} control board firmware"
    ]
  },
